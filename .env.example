# Shared local configuration for the Haymarket pipeline and app.
# Copy this file to `.env` and fill in real values. Do not commit `.env`.

# Required for LLM extraction and geolocation query modernization.
OPENAI_API_KEY=

# Required only when running `--action geocode` or `--geocode`.
GOOGLE_MAPS_API_KEY=

# Local-first storage defaults.
HAYMARKET_STORAGE_BACKEND=local
HAYMARKET_DATA_DIR=./data

# Optional S3 storage settings.
HAYMARKET_S3_BUCKET=
HAYMARKET_S3_PREFIX=

# Optional app setting.
FLASK_SECRET_KEY=
