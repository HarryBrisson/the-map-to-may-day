{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-map-to-may-day.local/schemas/cost_summary.schema.json",
  "title": "LLM Cost Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "generated_at", "totals", "by_model", "calls"],
  "properties": {
    "run_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "input_tokens", "output_tokens", "total_tokens", "cost_usd"],
      "properties": {
        "calls": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "by_model": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["calls", "input_tokens", "output_tokens", "total_tokens", "cost_usd"],
        "properties": {
          "calls": { "type": "integer", "minimum": 0 },
          "input_tokens": { "type": "integer", "minimum": 0 },
          "output_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["call_id", "provider", "model", "cost_usd", "status"],
        "properties": {
          "call_id": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "cost_usd": { "type": "number" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
